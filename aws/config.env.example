# Copy to config.env and fill in values

# required
S3_BUCKET=
OPENAI_API_KEY=

# benchmark settings
QUERY_LIMIT=500             # max questions to evaluate (0 = all)
TOP_K=5                     # passages to retrieve per query

# AWS
AWS_REGION=us-west-2
INSTANCE_TYPE=t3.large
EBS_SIZE_GB=50

USE_SPOT=false
SPOT_MAX_PRICE=1.2

KEY_NAME=hipporag-key
SECURITY_GROUP_NAME=hipporag-sg

IAM_ROLE_NAME=hipporag-ec2-role
INSTANCE_PROFILE_NAME=hipporag-ec2-profile

AUTO_TERMINATE=true

RUN_MODE=benchmark      # "demo" runs main.py only
RATE_LIMIT_DELAY=0.1

CORPUS_PATH=data/musique_corpus.json    # or data/hotpotqa_corpus.json
QUERIES_PATH=data/musique.json          # or data/hotpotqa.json
